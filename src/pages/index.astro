---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Transmission Tower Manufacturer" description="HB Power Tower - Steel transmission tower manufacturer for 66kV to 1000kV power line projects. Serving Southeast Asia, Middle East, Africa & Latin America.">

  <!-- Hero Section -->
  <section class="relative bg-steel-900 text-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <div class="max-w-3xl">
        <p class="text-brand-400 font-semibold text-sm uppercase tracking-wider mb-4">Steel Transmission Tower Manufacturer</p>
        <h1 class="text-4xl lg:text-6xl font-extrabold leading-tight mb-6">
          Power Line Towers<br />Built for Your Grid
        </h1>
        <p class="text-steel-300 text-lg lg:text-xl mb-8 max-w-2xl">
          From 66 kV distribution to ±800 kV UHV DC — lattice, monopole, guyed mast, and H-frame towers. ISO 9001 certified. Delivered to 20+ countries.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/quote/" class="inline-flex items-center justify-center px-6 py-3 bg-brand-500 text-white font-semibold rounded-lg hover:bg-brand-600 transition-colors text-center">
            Request a Quote
          </a>
          <a href="/projects/" class="inline-flex items-center justify-center px-6 py-3 border border-steel-500 text-steel-200 font-semibold rounded-lg hover:border-white hover:text-white transition-colors text-center">
            View Projects
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="bg-white border-b border-steel-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <p class="text-3xl font-bold text-steel-900">10+</p>
          <p class="text-sm text-steel-500 mt-1">Countries Served</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-steel-900">80,000</p>
          <p class="text-sm text-steel-500 mt-1">Tons Annual Capacity</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-steel-900">10–500</p>
          <p class="text-sm text-steel-500 mt-1">kV Voltage Range</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-steel-900">Since 1994</p>
          <p class="text-sm text-steel-500 mt-1">Exporting Worldwide</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Value Props -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <div class="text-center mb-12">
      <h2 class="text-3xl lg:text-4xl font-bold mb-4">Why Choose HB Power Tower</h2>
      <p class="text-steel-500 text-lg max-w-2xl mx-auto">Engineering precision meets manufacturing scale. We deliver transmission towers that meet international standards, on time and within budget.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="p-6 rounded-xl border border-steel-100 hover:border-brand-200 transition-colors">
        <div class="w-12 h-12 bg-brand-50 rounded-lg flex items-center justify-center mb-4">
          <span class="text-brand-500 text-2xl">⚡</span>
        </div>
        <h3 class="text-xl font-bold mb-2">Full Voltage Coverage</h3>
        <p class="text-steel-500">From 66 kV distribution lines to ±800 kV UHVDC — one manufacturer for your entire grid project.</p>
      </div>
      <div class="p-6 rounded-xl border border-steel-100 hover:border-brand-200 transition-colors">
        <div class="w-12 h-12 bg-brand-50 rounded-lg flex items-center justify-center mb-4">
          <span class="text-brand-500 text-2xl">🏭</span>
        </div>
        <h3 class="text-xl font-bold mb-2">In-house Everything</h3>
        <p class="text-steel-500">Design (PLS-CADD, Tower, SAP2000), fabrication, hot-dip galvanizing, testing, and export packing — all under one roof.</p>
      </div>
      <div class="p-6 rounded-xl border border-steel-100 hover:border-brand-200 transition-colors">
        <div class="w-12 h-12 bg-brand-50 rounded-lg flex items-center justify-center mb-4">
          <span class="text-brand-500 text-2xl">🌍</span>
        </div>
        <h3 class="text-xl font-bold mb-2">Proven in Your Region</h3>
        <p class="text-steel-500">Active projects in Southeast Asia, Middle East, Africa, and Latin America. We understand your logistics, standards, and timelines.</p>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-steel-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
      <h2 class="text-3xl font-bold mb-4">Have a Transmission Line Project?</h2>
      <p class="text-steel-500 text-lg mb-8 max-w-xl mx-auto">Tell us your voltage, tower type, and quantity. We'll respond with a technical proposal within 48 hours.</p>
      <a href="/quote/" class="inline-flex items-center px-8 py-4 bg-brand-500 text-white font-bold rounded-lg hover:bg-brand-600 transition-colors text-lg">
        Get Your Free Quote →
      </a>
    </div>
  </section>

</BaseLayout>
