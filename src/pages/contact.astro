---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Us" description="Get in touch with HB Power Tower. Email sales@90817.com or use our inquiry form.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <div class="grid lg:grid-cols-2 gap-16">
      <div>
        <h1 class="text-4xl font-bold mb-6">Contact Us</h1>
        <p class="text-steel-500 text-lg mb-8">Ready to discuss your project? Reach out below or use our <a href="/quote/" class="text-brand-500 hover:underline">detailed inquiry form</a>.</p>
        <div class="space-y-6">
          <div><h3 class="font-bold mb-1">Email</h3><a href="mailto:sales@90817.com" class="text-brand-500 text-lg">sales@90817.com</a></div>
          <div><h3 class="font-bold mb-1">WhatsApp</h3><p class="text-steel-600">[PLACEHOLDER: +86 XXX XXXX XXXX]</p></div>
          <div><h3 class="font-bold mb-1">Address</h3><p class="text-steel-600">[PLACEHOLDER: Hebei Province, China]</p></div>
        </div>
        <div class="mt-8 p-4 bg-steel-50 rounded-lg"><p class="text-sm text-steel-500"><strong>Response time:</strong> 24–48 business hours.</p></div>
      </div>
      <div class="bg-steel-50 rounded-2xl p-8">
        <h2 class="text-2xl font-bold mb-6">Quick Message</h2>
        <form action="#" method="POST" class="space-y-4">
          <input type="text" name="name" placeholder="Name *" required class="w-full px-4 py-2 border border-steel-200 rounded-lg" />
          <input type="email" name="email" placeholder="Email *" required class="w-full px-4 py-2 border border-steel-200 rounded-lg" />
          <input type="text" name="subject" placeholder="Subject" class="w-full px-4 py-2 border border-steel-200 rounded-lg" />
          <textarea name="message" rows="4" placeholder="Message *" required class="w-full px-4 py-2 border border-steel-200 rounded-lg"></textarea>
          <button type="submit" class="w-full px-6 py-3 bg-brand-500 text-white font-semibold rounded-lg hover:bg-brand-600 transition-colors">Send</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
