---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Engineering & Design" description="In-house tower design using PLS-CADD, PLS-Tower, SAP2000. Structural analysis for all voltage levels.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <p class="text-brand-500 font-semibold text-sm uppercase tracking-wider mb-2">Capabilities</p>
    <h1 class="text-4xl lg:text-5xl font-bold mb-6">Engineering & Design</h1>
    <p class="text-steel-500 text-lg mb-12 max-w-3xl">Our in-house engineering team handles the full design cycle — from line route optimization to detailed tower fabrication drawings.</p>

    <div class="grid lg:grid-cols-2 gap-12 mb-16">
      <div>
        <h2 class="text-2xl font-bold mb-4">Design Software</h2>
        <ul class="space-y-3 text-steel-600">
          <li class="flex items-start gap-3"><span class="text-brand-500 mt-1">✓</span> <strong>PLS-CADD</strong> — Line design and sag-tension</li>
          <li class="flex items-start gap-3"><span class="text-brand-500 mt-1">✓</span> <strong>PLS-Tower</strong> — Lattice tower structural analysis</li>
          <li class="flex items-start gap-3"><span class="text-brand-500 mt-1">✓</span> <strong>PLS-Pole</strong> — Monopole and H-frame analysis</li>
          <li class="flex items-start gap-3"><span class="text-brand-500 mt-1">✓</span> <strong>SAP2000 / STAAD.Pro</strong> — General FEA</li>
          <li class="flex items-start gap-3"><span class="text-brand-500 mt-1">✓</span> <strong>AutoCAD / Tekla</strong> — Fabrication detailing</li>
        </ul>
      </div>
      <div>
        <h2 class="text-2xl font-bold mb-4">Design Standards</h2>
        <ul class="space-y-3 text-steel-600">
          <li>IEC 60826 (international)</li>
          <li>ASCE 10 / ASCE 48 (USA)</li>
          <li>BS EN 50341 (Europe)</li>
          <li>IS 802 (India)</li>
          <li>GB 50545 / DL/T 5154 (China)</li>
          <li>Client-specific standards on request</li>
        </ul>
      </div>
    </div>

    <div class="bg-steel-50 rounded-2xl p-8">
      <h2 class="text-2xl font-bold mb-4">Engineering Team</h2>
      <div class="grid md:grid-cols-3 gap-6 text-center">
        <div><p class="text-3xl font-bold text-steel-900">[XX]</p><p class="text-sm text-steel-500">Structural Engineers</p></div>
        <div><p class="text-3xl font-bold text-steel-900">[XX]</p><p class="text-sm text-steel-500">CAD Draftsmen</p></div>
        <div><p class="text-3xl font-bold text-steel-900">[XX]+</p><p class="text-sm text-steel-500">Years Average Experience</p></div>
      </div>
    </div>

    <div class="mt-12 text-center">
      <a href="/quote/" class="inline-flex items-center px-8 py-4 bg-brand-500 text-white font-bold rounded-lg hover:bg-brand-600 transition-colors">Discuss Your Design Requirements →</a>
    </div>
  </section>
</BaseLayout>
