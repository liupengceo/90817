---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Manufacturing" description="Modern fabrication facility with CNC processing, robotic welding, and strict quality control.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <p class="text-brand-500 font-semibold text-sm uppercase tracking-wider mb-2">Capabilities</p>
    <h1 class="text-4xl lg:text-5xl font-bold mb-6">Manufacturing</h1>
    <p class="text-steel-500 text-lg mb-12 max-w-3xl">Our factory combines modern CNC equipment with rigorous quality control to deliver towers that fit precisely on site.</p>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      <div class="text-center p-6 bg-steel-50 rounded-xl"><p class="text-3xl font-bold text-steel-900">[XX,000]</p><p class="text-sm text-steel-500">MT Annual Capacity</p></div>
      <div class="text-center p-6 bg-steel-50 rounded-xl"><p class="text-3xl font-bold text-steel-900">[XX,000]</p><p class="text-sm text-steel-500">m² Factory Area</p></div>
      <div class="text-center p-6 bg-steel-50 rounded-xl"><p class="text-3xl font-bold text-steel-900">[XX]</p><p class="text-sm text-steel-500">CNC Lines</p></div>
      <div class="text-center p-6 bg-steel-50 rounded-xl"><p class="text-3xl font-bold text-steel-900">±1mm</p><p class="text-sm text-steel-500">Hole Accuracy</p></div>
    </div>

    <h2 class="text-2xl font-bold mb-6">Production Process</h2>
    <ol class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 mb-16 list-none">
      <li class="p-4 border border-steel-100 rounded-lg"><span class="text-brand-500 font-bold">1.</span> Material receiving & inspection</li>
      <li class="p-4 border border-steel-100 rounded-lg"><span class="text-brand-500 font-bold">2.</span> CNC angle cutting & punching</li>
      <li class="p-4 border border-steel-100 rounded-lg"><span class="text-brand-500 font-bold">3.</span> CNC plate cutting</li>
      <li class="p-4 border border-steel-100 rounded-lg"><span class="text-brand-500 font-bold">4.</span> Welding (AWS D1.1)</li>
      <li class="p-4 border border-steel-100 rounded-lg"><span class="text-brand-500 font-bold">5.</span> Trial assembly</li>
      <li class="p-4 border border-steel-100 rounded-lg"><span class="text-brand-500 font-bold">6.</span> Hot-dip galvanizing</li>
      <li class="p-4 border border-steel-100 rounded-lg"><span class="text-brand-500 font-bold">7.</span> Final inspection & marking</li>
      <li class="p-4 border border-steel-100 rounded-lg"><span class="text-brand-500 font-bold">8.</span> Packing & loading</li>
    </ol>

    <div class="bg-steel-900 text-white rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold mb-3">Factory Tour</h2>
      <p class="text-steel-300 mb-6">We welcome visits. Contact us to arrange a tour or virtual walkthrough.</p>
      <a href="/contact/" class="inline-flex items-center px-6 py-3 border border-steel-500 text-white font-semibold rounded-lg hover:border-white transition-colors">Schedule a Visit →</a>
    </div>
  </section>
</BaseLayout>
