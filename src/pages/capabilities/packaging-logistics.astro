---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Packaging & Logistics" description="Export-grade packaging for ocean freight. Shipping to 20+ countries.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <p class="text-brand-500 font-semibold text-sm uppercase tracking-wider mb-2">Capabilities</p>
    <h1 class="text-4xl lg:text-5xl font-bold mb-6">Packaging & Logistics</h1>
    <p class="text-steel-500 text-lg mb-12 max-w-3xl">Getting towers from factory to site — intact and on schedule.</p>

    <div class="grid md:grid-cols-2 gap-12 mb-16">
      <div>
        <h2 class="text-2xl font-bold mb-4">Packaging</h2>
        <ul class="space-y-2 text-steel-600">
          <li>✓ Members bundled by tower number</li>
          <li>✓ Steel strapping on timber cradles</li>
          <li>✓ Bolt bags attached to bundles</li>
          <li>✓ Waterproof marking (stencil + metal tags)</li>
          <li>✓ Container-optimized loading plans</li>
        </ul>
      </div>
      <div>
        <h2 class="text-2xl font-bold mb-4">Logistics</h2>
        <ul class="space-y-2 text-steel-600">
          <li><strong>Ports:</strong> Tianjin, Qingdao, Shanghai, Guangzhou</li>
          <li><strong>Modes:</strong> FCL container, break-bulk, RoRo</li>
          <li><strong>Destinations:</strong> 20+ countries</li>
          <li><strong>Docs:</strong> CI, PL, BL, CO, fumigation, insurance</li>
        </ul>
      </div>
    </div>

    <div class="bg-steel-50 rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold mb-3">Need CFR / CIF Quote?</h2>
      <p class="text-steel-500 mb-6">Tell us your destination port and we'll include freight in our proposal.</p>
      <a href="/quote/" class="inline-flex items-center px-6 py-3 bg-brand-500 text-white font-semibold rounded-lg hover:bg-brand-600 transition-colors">Request Quote with Freight →</a>
    </div>
  </section>
</BaseLayout>
