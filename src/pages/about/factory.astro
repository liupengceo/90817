---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Factory" description="Modern steel tower fabrication facility with CNC lines, galvanizing bath, and trial assembly yard.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <p class="text-brand-500 font-semibold text-sm uppercase tracking-wider mb-2">Our Factory</p>
    <h1 class="text-4xl lg:text-5xl font-bold mb-6">Manufacturing Base</h1>
    <p class="text-steel-500 text-lg mb-12 max-w-3xl">Located in [PLACEHOLDER: Hebei Province, China], our factory covers [XX,000] m² with dedicated areas for each production stage.</p>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      <div class="text-center p-6 bg-steel-50 rounded-xl"><p class="text-3xl font-bold text-steel-900">[XX,000]</p><p class="text-sm text-steel-500">m² Total Area</p></div>
      <div class="text-center p-6 bg-steel-50 rounded-xl"><p class="text-3xl font-bold text-steel-900">[XX,000]</p><p class="text-sm text-steel-500">MT/Year Capacity</p></div>
      <div class="text-center p-6 bg-steel-50 rounded-xl"><p class="text-3xl font-bold text-steel-900">[XX]</p><p class="text-sm text-steel-500">Production Lines</p></div>
      <div class="text-center p-6 bg-steel-50 rounded-xl"><p class="text-3xl font-bold text-steel-900">[XXX]+</p><p class="text-sm text-steel-500">Workers</p></div>
    </div>

    <h2 class="text-2xl font-bold mb-6">Factory Gallery</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 mb-16">
      <div class="aspect-video bg-steel-100 rounded-lg flex items-center justify-center text-steel-300 text-sm">[Factory Photo #1]</div>
      <div class="aspect-video bg-steel-100 rounded-lg flex items-center justify-center text-steel-300 text-sm">[Factory Photo #2]</div>
      <div class="aspect-video bg-steel-100 rounded-lg flex items-center justify-center text-steel-300 text-sm">[Factory Photo #3]</div>
      <div class="aspect-video bg-steel-100 rounded-lg flex items-center justify-center text-steel-300 text-sm">[Factory Photo #4]</div>
      <div class="aspect-video bg-steel-100 rounded-lg flex items-center justify-center text-steel-300 text-sm">[Factory Photo #5]</div>
      <div class="aspect-video bg-steel-100 rounded-lg flex items-center justify-center text-steel-300 text-sm">[Factory Photo #6]</div>
    </div>

    <h2 class="text-2xl font-bold mb-6">Key Equipment</h2>
    <div class="grid md:grid-cols-2 gap-4 mb-16">
      <div class="p-4 border border-steel-100 rounded-lg"><strong>CNC Angle Line:</strong> [PLACEHOLDER: brand, model, capacity]</div>
      <div class="p-4 border border-steel-100 rounded-lg"><strong>CNC Plate Line:</strong> [PLACEHOLDER: brand, model]</div>
      <div class="p-4 border border-steel-100 rounded-lg"><strong>Galvanizing Bath:</strong> [X.X] × [X.X] × [X.X] m</div>
      <div class="p-4 border border-steel-100 rounded-lg"><strong>Trial Assembly Yard:</strong> [XX] m × [XX] m</div>
      <div class="p-4 border border-steel-100 rounded-lg"><strong>Welding Stations:</strong> [XX] semi-auto MIG/MAG</div>
      <div class="p-4 border border-steel-100 rounded-lg"><strong>Crane Capacity:</strong> [XX] ton overhead crane</div>
    </div>

    <div class="text-center">
      <a href="/contact/" class="inline-flex items-center px-8 py-4 bg-brand-500 text-white font-bold rounded-lg hover:bg-brand-600 transition-colors">Schedule a Factory Visit →</a>
    </div>
  </section>
</BaseLayout>
