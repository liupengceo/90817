---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About Us" description="HB Power Tower Co., Ltd. — steel transmission tower manufacturer based in Hebei, China.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <p class="text-brand-500 font-semibold text-sm uppercase tracking-wider mb-2">About Us</p>
    <h1 class="text-4xl lg:text-5xl font-bold mb-6">HB Power Tower Co., Ltd.</h1>

    <div class="max-w-3xl text-lg text-steel-600 space-y-4 mb-12">
      <p>[PLACEHOLDER: Company introduction — founding year, location, core business, value proposition. 2-3 sentences.]</p>
      <p>[PLACEHOLDER: Growth story — international expansion, key milestones, current scale.]</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      <div class="text-center p-6 bg-steel-50 rounded-xl"><p class="text-3xl font-bold text-steel-900">[YEAR]</p><p class="text-sm text-steel-500">Founded</p></div>
      <div class="text-center p-6 bg-steel-50 rounded-xl"><p class="text-3xl font-bold text-steel-900">[XX]k</p><p class="text-sm text-steel-500">MT Annual Capacity</p></div>
      <div class="text-center p-6 bg-steel-50 rounded-xl"><p class="text-3xl font-bold text-steel-900">[XX]+</p><p class="text-sm text-steel-500">Countries Served</p></div>
      <div class="text-center p-6 bg-steel-50 rounded-xl"><p class="text-3xl font-bold text-steel-900">[XXX]+</p><p class="text-sm text-steel-500">Employees</p></div>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="p-6 border border-steel-100 rounded-xl">
        <h3 class="font-bold text-lg mb-2">Our Mission</h3>
        <p class="text-steel-500">[PLACEHOLDER: Delivering reliable power infrastructure to developing markets.]</p>
      </div>
      <div class="p-6 border border-steel-100 rounded-xl">
        <h3 class="font-bold text-lg mb-2">Our Advantage</h3>
        <p class="text-steel-500">Vertically integrated: design → fabrication → galvanizing → testing → export, all under one roof.</p>
      </div>
      <div class="p-6 border border-steel-100 rounded-xl">
        <h3 class="font-bold text-lg mb-2">Our Commitment</h3>
        <p class="text-steel-500">On-time delivery, zero-defect assembly, and responsive communication.</p>
      </div>
    </div>
  </section>
</BaseLayout>
