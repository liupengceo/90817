---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = [
  {
    country: 'Thailand',
    region: 'Southeast Asia',
    year: 2018,
    voltage: '132 kV',
    towerCount: 200,
    towerType: 'Lattice (angle steel)',
    description: '132 kV single-circuit transmission line project. 200 lattice towers designed, fabricated, galvanized, and exported to Thailand.',
  },
  {
    country: 'Pakistan',
    region: 'South Asia',
    year: 2020,
    voltage: '220 kV',
    towerCount: 350,
    towerType: 'Lattice (angle steel)',
    description: '220 kV transmission line project. 350 angle-steel lattice towers manufactured and shipped to Pakistan. Full tower supply including hardware and accessories.',
  },
  {
    country: 'Mongolia',
    region: 'East Asia',
    year: 2022,
    voltage: '110 kV',
    towerCount: 80,
    towerType: 'Lattice (angle steel)',
    description: '110 kV distribution line project for rural electrification in Mongolia. 80 towers designed for extreme cold climate conditions (-40°C).',
  },
];
---

<BaseLayout title="Projects" description="Transmission tower projects delivered to Thailand, Pakistan, Mongolia and more. 10+ countries served since 1994.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <p class="text-brand-500 font-semibold text-sm uppercase tracking-wider mb-2">Track Record</p>
    <h1 class="text-4xl lg:text-5xl font-bold mb-6">Our Projects</h1>
    <p class="text-steel-500 text-lg mb-12 max-w-3xl">Since 1994, we have delivered transmission towers to over 10 countries across Southeast Asia, South Asia, Middle East, and Africa. Below are selected recent projects.</p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {projects.map(p => (
        <div class="rounded-xl border border-steel-100 overflow-hidden hover:border-brand-200 hover:shadow-lg transition-all">
          <div class="h-48 bg-steel-100 flex items-center justify-center text-steel-300 text-sm">[Project Photo: {p.country} {p.voltage}]</div>
          <div class="p-5">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs font-semibold text-brand-500 uppercase">{p.country}</span>
              <span class="text-xs text-steel-400">· {p.year}</span>
            </div>
            <h3 class="font-bold text-lg mb-2">{p.voltage} Transmission Line</h3>
            <p class="text-sm text-steel-500 mb-3">{p.description}</p>
            <div class="flex flex-wrap gap-2">
              <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">{p.voltage}</span>
              <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">{p.towerCount} towers</span>
              <span class="text-xs bg-steel-50 text-steel-600 px-2 py-1 rounded">{p.towerType}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Export history -->
    <div class="bg-steel-50 rounded-2xl p-8 mb-16">
      <h2 class="text-2xl font-bold mb-6 text-center">Countries We Have Served</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {['Thailand', 'Pakistan', 'Mongolia', 'Iran', 'Laos', 'Burundi', 'Cambodia', 'Myanmar', 'Bangladesh', 'Nigeria'].map(c => (
          <span class="px-4 py-2 bg-white border border-steel-200 rounded-full text-sm text-steel-700 font-medium">{c}</span>
        ))}
      </div>
      <p class="text-center text-steel-400 text-sm mt-4">And more — 10+ countries since 1994</p>
    </div>

    <!-- CTA -->
    <div class="bg-steel-900 text-white rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold mb-3">Your Project Could Be Next</h2>
      <p class="text-steel-300 mb-6">Tell us your requirements for a technical proposal with relevant references.</p>
      <a href="/quote/" class="inline-flex items-center px-8 py-4 bg-brand-500 text-white font-bold rounded-lg hover:bg-brand-600 transition-colors">Start Your Inquiry →</a>
    </div>
  </section>
</BaseLayout>
