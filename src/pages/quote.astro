---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Request a Quote" description="Get a free technical proposal for your transmission tower project. Tell us your voltage, tower type, and quantity.">

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <h1 class="text-3xl lg:text-4xl font-bold mb-4">Request a Quote</h1>
    <p class="text-steel-500 text-lg mb-8">Fill in your project details below. We typically respond within 48 business hours with a technical proposal.</p>

    <form action="#" method="POST" class="space-y-6">
      <!-- Contact -->
      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <label for="name" class="block text-sm font-medium text-steel-700 mb-1">Your Name *</label>
          <input type="text" id="name" name="name" required class="w-full px-4 py-2 border border-steel-200 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
        </div>
        <div>
          <label for="company" class="block text-sm font-medium text-steel-700 mb-1">Company *</label>
          <input type="text" id="company" name="company" required class="w-full px-4 py-2 border border-steel-200 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <label for="email" class="block text-sm font-medium text-steel-700 mb-1">Email *</label>
          <input type="email" id="email" name="email" required class="w-full px-4 py-2 border border-steel-200 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
        </div>
        <div>
          <label for="phone" class="block text-sm font-medium text-steel-700 mb-1">Phone / WhatsApp</label>
          <input type="tel" id="phone" name="phone" class="w-full px-4 py-2 border border-steel-200 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
        </div>
      </div>

      <div>
        <label for="country" class="block text-sm font-medium text-steel-700 mb-1">Project Country *</label>
        <input type="text" id="country" name="country" required placeholder="e.g. Nigeria, Philippines, Saudi Arabia" class="w-full px-4 py-2 border border-steel-200 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
      </div>

      <!-- Project specs -->
      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <label for="voltage" class="block text-sm font-medium text-steel-700 mb-1">Voltage Level *</label>
          <select id="voltage" name="voltage" required class="w-full px-4 py-2 border border-steel-200 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            <option value="">Select voltage</option>
            <option value="66kv">66 kV</option>
            <option value="110-132kv">110 / 132 kV</option>
            <option value="220-230kv">220 / 230 kV</option>
            <option value="330-400kv">330 / 400 kV</option>
            <option value="500kv">500 kV</option>
            <option value="765kv+">765 kV / UHV</option>
            <option value="hvdc">HVDC (±500 / ±800 kV)</option>
            <option value="other">Other / Multiple</option>
          </select>
        </div>
        <div>
          <label for="tower-type" class="block text-sm font-medium text-steel-700 mb-1">Tower Type</label>
          <select id="tower-type" name="tower_type" class="w-full px-4 py-2 border border-steel-200 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            <option value="">Select type (if known)</option>
            <option value="lattice-angle">Lattice (angle steel)</option>
            <option value="lattice-tubular">Lattice (tubular)</option>
            <option value="monopole">Monopole</option>
            <option value="guyed">Guyed mast</option>
            <option value="h-frame">H-frame / Compact</option>
            <option value="substation">Substation structure</option>
            <option value="not-sure">Not sure yet</option>
          </select>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <label for="quantity" class="block text-sm font-medium text-steel-700 mb-1">Estimated Quantity (towers)</label>
          <input type="text" id="quantity" name="quantity" placeholder="e.g. 200 towers" class="w-full px-4 py-2 border border-steel-200 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
        </div>
        <div>
          <label for="tonnage" class="block text-sm font-medium text-steel-700 mb-1">Estimated Tonnage</label>
          <input type="text" id="tonnage" name="tonnage" placeholder="e.g. 5,000 MT" class="w-full px-4 py-2 border border-steel-200 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
        </div>
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-steel-700 mb-1">Additional Details</label>
        <textarea id="message" name="message" rows="4" placeholder="Project timeline, standards required (IEC/ASCE/BS), special requirements..." class="w-full px-4 py-2 border border-steel-200 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500"></textarea>
      </div>

      <div>
        <button type="submit" class="w-full md:w-auto px-8 py-3 bg-brand-500 text-white font-bold rounded-lg hover:bg-brand-600 transition-colors text-lg">
          Submit Inquiry
        </button>
        <p class="text-sm text-steel-400 mt-2">We respond within 48 business hours. Your information is confidential.</p>
      </div>
    </form>
  </section>

</BaseLayout>
