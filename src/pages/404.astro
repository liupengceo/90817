---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <section class="max-w-2xl mx-auto px-4 py-32 text-center">
    <h1 class="text-6xl font-bold text-steel-200 mb-4">404</h1>
    <p class="text-xl text-steel-500 mb-8">The page you're looking for doesn't exist.</p>
    <a href="/" class="inline-flex items-center px-6 py-3 bg-brand-500 text-white font-semibold rounded-lg hover:bg-brand-600 transition-colors">
      Back to Homepage
    </a>
  </section>
</BaseLayout>
