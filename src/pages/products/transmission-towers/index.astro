---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const towerTypes = [
  { name: 'Lattice Tower (Angle Steel)', slug: 'lattice-angle-steel', desc: 'The most widely used type. Equal-angle steel members bolted together.', voltages: '66 kV – 1000 kV' },
  { name: 'Lattice Tower (Tubular)', slug: 'lattice-tubular', desc: 'Round hollow sections for reduced wind load and urban aesthetics.', voltages: '110 kV – 500 kV' },
  { name: 'Monopole Tower', slug: 'monopole', desc: 'Single-pole for narrow right-of-way. Compact urban footprint.', voltages: '66 kV – 400 kV' },
  { name: 'Guyed Mast', slug: 'guyed-mast', desc: 'Lightweight, guy-wire stabilized. Cost-effective for flat terrain.', voltages: '132 kV – 765 kV' },
  { name: 'H-Frame / Compact', slug: 'compact-h-frame', desc: 'Two-pole portal frame for low visual impact areas.', voltages: '69 kV – 230 kV' },
];
---

<BaseLayout title="Transmission Towers" description="Steel transmission towers for 66 kV to 1000 kV power lines. Lattice, monopole, guyed, and H-frame structures.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <p class="text-brand-500 font-semibold text-sm uppercase tracking-wider mb-2">Our Core Product</p>
    <h1 class="text-4xl lg:text-5xl font-bold mb-6">Transmission Line Towers</h1>
    <p class="text-steel-500 text-lg mb-12 max-w-3xl">We design and manufacture steel transmission towers for all voltage levels — from 66 kV distribution to ±800 kV UHV DC.</p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {towerTypes.map(t => (
        <a href={`/products/transmission-towers/${t.slug}/`} class="group block p-6 rounded-xl border border-steel-100 hover:border-brand-300 hover:shadow-lg transition-all">
          <div class="h-32 bg-steel-100 rounded-lg mb-4 flex items-center justify-center text-steel-300 text-sm">[Photo: {t.name}]</div>
          <h3 class="text-lg font-bold group-hover:text-brand-500 transition-colors mb-2">{t.name}</h3>
          <p class="text-steel-500 text-sm mb-3">{t.desc}</p>
          <p class="text-xs text-steel-400">Voltage: {t.voltages}</p>
        </a>
      ))}
    </div>

    <div class="text-center">
      <a href="/quote/" class="inline-flex items-center px-8 py-4 bg-brand-500 text-white font-bold rounded-lg hover:bg-brand-600 transition-colors text-lg">Get a Quote →</a>
    </div>
  </section>
</BaseLayout>
